<?xml version="1.0" encoding="utf-8"?>
<!-- Backup is off entirely (android:allowBackup="false"); this is the belt to that
     brace. The key pair and the pairing tokens are this phone's access to its own
     camera roll and have no business leaving it. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
